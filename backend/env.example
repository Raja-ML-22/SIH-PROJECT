# Copy this file to `.env` in the same folder and fill in real values.
# `.env` itself is gitignored — never commit real keys.

# Required. Powers semantic search (embeddings) via Hugging Face's hosted
# Inference API instead of loading a model locally.
# Get a free token (Read access is enough) at:
#   https://huggingface.co/settings/tokens
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. If set, multilingual translation uses the official, documented
# Google Cloud Translation API (500,000 chars/month free) instead of the
# free but rate-limited scraping-based fallback. Get a key at:
#   https://console.cloud.google.com/apis/credentials
# (enable the "Cloud Translation API" on your project first)
GOOGLE_TRANSLATE_API_KEY=
